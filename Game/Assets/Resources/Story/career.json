   "go": "e_kui_end"
  },
  {
   "type": "label",
   "id": "e_kui"
  },
  {
   "type": "say",
   "who": "kui",
   "name": "月希",
   "text": "老闆，我開台幫你募款好不好？"
  },
  {
   "type": "label",
   "id": "e_kui_end"
  },
  {
   "type": "branch",
   "cond": "flag:mem_lin",
   "go": "e_lin"
  },
  {
   "type": "goto",
   "go": "e_lin_end"
  },
  {
