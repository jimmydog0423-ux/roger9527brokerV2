   "go": "e_clean"
  },
  {
   "type": "goto",
   "go": "e_clean_end"
  },
  {
   "type": "label",
   "id": "e_clean"
  },
  {
   "type": "say",
   "who": "",
   "name": "",
   "text": "那些被你拒絕過的可疑中間人，一個都沒有出現。你覺得這樣很好。"
  },
  {
   "type": "label",
   "id": "e_clean_end"
  },
  {
   "type": "branch",
   "cond": "flag:mem_chaos",
   "go": "e_chaos"
  },
  {
