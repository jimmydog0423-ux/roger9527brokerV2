   "go": "e_tal_end"
  },
  {
   "type": "label",
   "id": "e_tal"
  },
  {
   "type": "say",
   "who": "",
   "name": "",
   "text": "水蛇洞的藝人們坐了滿滿一桌，大家都在幫羅傑錄影。"
  },
  {
   "type": "label",
   "id": "e_tal_end"
  },
  {
   "type": "branch",
   "cond": "flag:mem_gray_take",
   "go": "e_gray"
