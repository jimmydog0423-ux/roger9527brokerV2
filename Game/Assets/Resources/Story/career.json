  },
  {
   "type": "say",
   "who": "wang",
   "name": "王小姐",
   "text": "喵喵罐頭贊助了一整車罐頭當伴手禮！恭喜恭喜！"
  },
  {
   "type": "label",
   "id": "e_wang_end"
  },
