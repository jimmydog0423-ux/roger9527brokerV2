   "id": "e_lin"
  },
  {
   "type": "say",
   "who": "lin",
   "name": "林經理",
   "text": "星海飲料的祝賀……這次我們不讓他喝了。"
  },
  {
   "type": "label",
   "id": "e_lin_end"
  },
  {
   "type": "branch",
   "cond": "flag:mem_talents",
   "go": "e_tal"
  },
  {
